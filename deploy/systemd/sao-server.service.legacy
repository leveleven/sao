# sao Agent channel server (systemd 226–229: ProtectSystem=strict; >= 230 use sao-server.service)
[Unit]
Description=sao Agent channel server
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/sao-server --config /etc/sao/config.yaml
Restart=on-failure

# Equivalent to ReadOnlyPaths for 226–229 (strict: ro / except /tmp /run etc.)
ProtectSystem=strict
ProtectHome=read-only

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
